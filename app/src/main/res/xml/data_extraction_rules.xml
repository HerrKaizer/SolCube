<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Google backup and phone-to-phone transfer carry Suite's settings -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="updates.xml" />
        <exclude domain="sharedpref" path="ipc.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="updates.xml" />
        <exclude domain="sharedpref" path="ipc.xml" />
    </device-transfer>
</data-extraction-rules>
