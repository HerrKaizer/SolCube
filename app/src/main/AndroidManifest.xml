<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- localhost socket between the shell-side listener and the ripple overlay -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- double press: silent mode needs Do Not Disturb access (granted through Shizuku) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- to show game names (apps with a launcher icon), and who handles the double power press -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="vivo.intent.action.NFC_BUS_SWINGSPLASH" />
        </intent>
        <package android:name="com.vivo.wallet" />
    </queries>

    <application
        android:label="SolCube"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- vivo Wallet's "double press power" lists apps that declare these (copied from the
             Double Power Key app) -->
        <meta-data android:name="com.vivo.wallet.support.typeswing" android:value="true" />
        <meta-data android:name="com.vivo.wallet.nfc.SupportDoubleClick" android:value="true" />
        <meta-data android:name="com.vivo.wallet.nfc.CommonSupportDoubleClick" android:value="true" />
        <meta-data android:name="com.vivo.wallet.nfc.supportVersion" android:value="2" />
        <meta-data android:name="com.vivo.pay.nfc.supportVersion" android:value="1" />

        <!-- Double power press: vivo fires NFC_BUS_SWINGSPLASH; invisible, finishes at once -->
        <activity
            android:name=".DoublePressActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity="dev.suite.doublepress"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="true">
            <intent-filter>
                <action android:name="vivo.intent.action.NFC_BUS_SWINGSPLASH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="com.vivo.wallet.support.typeswing" android:value="true" />
            <meta-data android:name="com.vivo.wallet.nfc.SupportDoubleClick" android:value="true" />
            <meta-data android:name="com.vivo.wallet.nfc.CommonSupportDoubleClick" android:value="true" />
            <meta-data android:name="com.vivo.wallet.nfc.supportVersion" android:value="2" />
            <meta-data android:name="com.vivo.pay.nfc.supportVersion" android:value="1" />
        </activity>

        <!-- Power-button hold action: started by the shell listener only (only shell/system hold
             this permission). The double press above has to stay open: vivo's system sends it. -->
        <activity
            android:name=".HoldActivity"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity="dev.suite.hold"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- update pop-up from the daily GitHub check -->
        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity="dev.suite.update"
            android:excludeFromRecents="true"
            android:noHistory="true" />


        <!-- developer test hook; only shell/system hold this permission -->
        <receiver
            android:name=".TestReceiver"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <receiver
            android:name=".IslandReceiver"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Exported only so the shell-side listener can restart it after vivo's cleaner
             force-stops SolCube; the permission limits callers to shell/system. -->
        <service
            android:name=".SolCubeService"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Temperature overlay and the Circle to Search ripple overlay" />
        </service>

        <!-- Quick Settings tiles: the same switches as the cards -->
        <service
            android:name=".FiTile"
            android:label="Frame interpolation"
            android:icon="@drawable/ic_tile_fi"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service
            android:name=".SrTile"
            android:label="Super resolution"
            android:icon="@drawable/ic_tile_sr"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service
            android:name=".MixTile"
            android:label="Play together"
            android:icon="@drawable/ic_tile_mix"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

        <service
            android:name=".SolCubeA11y"
            android:label="@string/a11y_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y" />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
